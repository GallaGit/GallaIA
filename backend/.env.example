APP_NAME=GallaAI AgentOS
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# MVP uses SQLite. For Postgres later:
# DATABASE_URL=postgresql+psycopg://gallaai:gallaai@localhost:5432/gallaai
DATABASE_URL=sqlite:///./data/gallaia.db

# Comma-separated Vite origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GALLAIA-SEC-011: allowed Host headers (DNS rebinding guard). Comma-separated, no port.
ALLOWED_HOSTS=localhost,127.0.0.1

# Operator token required by every /api/v1 route (except the signed webhook).
# Required, at least 32 characters. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Never commit the real value.
GALLAIA_OPERATOR_TOKEN=

# GALLAIA-SEC-007: extra origins allowed in the SPA CSP connect-src (comma-separated).
# Only needed if the UI is built with VITE_API_URL pointing to another origin.
# CSP_EXTRA_CONNECT_SRC=

# Optional LLM for runners (never commit real keys)
# ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenRouter Chat Completions (paste key locally; never commit it)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq (fallback provider; paste key locally, never commit it)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# F2.1b — gateway backend: http (default, no extra deps) | litellm (optional).
# litellm is NOT installed by default: `pip install litellm` first; if it is
# missing the gateway logs a warning and keeps using http.
# GALLAIA_LLM_BACKEND=http

# F2.2a — thread engine: classic (default, plain loop) | langgraph.
# langgraph is NOT installed by default: `pip install langgraph` first; if it is
# missing the classic engine keeps running and a warning is logged.
# GALLAIA_THREAD_ENGINE=classic  # or langgraph (needs: pip install langgraph)

# F2.2b — LangGraph checkpoint store: SQLite file path (default) or "memory".
# GALLAIA_CHECKPOINT_DB=./data/checkpoints.db  # or memory (needs: pip install langgraph-checkpoint-sqlite)

# F2.2c — require human approval in the Inbox before fe/be answer a delegation.
# GALLAIA_THREAD_APPROVAL=false  # or true (only with GALLAIA_THREAD_ENGINE=langgraph)

# Agent secret refs resolve from process env at session start (never store values in SQLite).
# Tests use a fake fixture, e.g. GALLAIA_TEST_SECRET_FOO=not-a-real-key
# GALLAIA_TEST_SECRET_FOO=

# Phase 5 Triggers — shared secret for POST /api/v1/triggers/webhook (header X-Webhook-Secret).
# Empty/unset => all webhook calls return 401. Tests set a fixture value.
# GALLAIA_WEBHOOK_SECRET=

# Phase 7 — runner routing: mock | local (local -> local-stub until OS binary exists)
# GALLAIA_RUNNER_ROUTE=mock

# Phase 7 - optional Web Push VAPID (empty => POST /api/v1/push/* returns 503).
# Never commit production keys. Real send (pywebpush) is a follow-up.

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
