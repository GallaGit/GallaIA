APP_NAME=GallaAI AgentOS
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# MVP uses SQLite. For Postgres later:
# DATABASE_URL=postgresql+psycopg://gallaai:gallaai@localhost:5432/gallaai
DATABASE_URL=sqlite:///./data/gallaia.db

# Comma-separated Vite origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LLM for runners (never commit real keys)
# ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenRouter Chat Completions (paste key locally; never commit it)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
